# Secrets for the LOCAL stack (docker-compose.yml). Copy to .env and fill in.
# .env is gitignored. These are never given to a student.

# Superuser password of the lab's PostgreSQL server. Letters and digits only:
# it is placed inside a connection URL, where / @ : and similar break it.
#   openssl rand -hex 24
PG_ADMIN_PASSWORD=

# Qdrant admin key. It also SIGNS every student token, so it must be long:
#   openssl rand -base64 48
QDRANT_ADMIN_KEY=

# Any long random string. Student database passwords are derived from it
# (HMAC), so re-provisioning a student yields the same password. Changing it
# rotates every student's password on the next provisioning run.
#   openssl rand -hex 32
PROVISION_SECRET=

# The student's model gateway. Bifrost is not part of this stack - use the
# existing deployment's public URL (ending in /v1) and a virtual key minted for
# the student (ai-lab/bifrost-gateway/mint-vk.sh). Without these, everything
# except the model works: milestones 1 and 3-7 do not need it.
GATEWAY_URL=
AI_KEY=

# ── Optional ─────────────────────────────────────────────────────────────────
# Model for the provisioned student (default: anthropic/claude-opus-5-5).
# The virtual key must allow it.
# STUDENT_LLM_MODEL=anthropic/claude-haiku-5-5

# Host ports, if a default one is already taken on this machine.
# PG_LOCAL_PORT=5432
# QDRANT_LOCAL_PORT=6333
# FUSEKI_LOCAL_PORT=3030
# WORKSPACE_LOCAL_PORT=8888

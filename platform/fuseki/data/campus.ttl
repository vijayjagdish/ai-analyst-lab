# ── Career tracks ────────────────────────────────────────────────────────
track:data-scientist a cc:CareerTrack ;
    rdfs:label "Data Scientist" ;
    cc:requiresSkill skill:statistics, skill:machine-learning, skill:programming, skill:databases .
track:backend-engineer a cc:CareerTrack ;
    rdfs:label "Backend Engineer" ;
    cc:requiresSkill skill:programming, skill:algorithms, skill:databases, skill:systems .
track:cloud-devops-engineer a cc:CareerTrack ;
    rdfs:label "Cloud and DevOps Engineer" ;
    cc:requiresSkill skill:networking, skill:cloud-devops, skill:systems .
track:security-analyst a cc:CareerTrack ;
    rdfs:label "Security Analyst" ;
    cc:requiresSkill skill:networking, skill:security, skill:systems .
track:full-stack-developer a cc:CareerTrack ;
    rdfs:label "Full Stack Developer" ;
    cc:requiresSkill skill:web-development, skill:databases, skill:programming, skill:software-engineering .
track:embedded-systems-engineer a cc:CareerTrack ;
    rdfs:label "Embedded Systems Engineer" ;
    cc:requiresSkill skill:embedded-systems, skill:digital-design, skill:circuit-design .
track:vlsi-design-engineer a cc:CareerTrack ;
    rdfs:label "VLSI Design Engineer" ;
    cc:requiresSkill skill:vlsi, skill:digital-design, skill:circuit-design .
track:wireless-communication-engineer a cc:CareerTrack ;
    rdfs:label "Wireless Communication Engineer" ;
    cc:requiresSkill skill:signal-processing, skill:communication-systems, skill:electromagnetics .
track:thermal-design-engineer a cc:CareerTrack ;
    rdfs:label "Thermal Design Engineer" ;
    cc:requiresSkill skill:thermal-engineering, skill:fluid-mechanics, skill:cad-cae .
track:automotive-design-engineer a cc:CareerTrack ;
    rdfs:label "Automotive Design Engineer" ;
    cc:requiresSkill skill:machine-design, skill:cad-cae, skill:manufacturing, skill:solid-mechanics .
track:structural-design-engineer a cc:CareerTrack ;
    rdfs:label "Structural Design Engineer" ;
    cc:requiresSkill skill:structural-design, skill:solid-mechanics, skill:geotechnical .
track:construction-project-manager a cc:CareerTrack ;
    rdfs:label "Construction Project Manager" ;
    cc:requiresSkill skill:construction-management, skill:surveying, skill:materials .


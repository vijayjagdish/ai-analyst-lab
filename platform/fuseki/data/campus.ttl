# CreamCollar Institute of Technology (CCIT) - curriculum knowledge graph.
# GENERATED by tools/generate_dataset.py from tools/campus_data.py. Do not edit by hand.
#
# Loaded read-only into Apache Jena Fuseki as dataset /campus.
# Subject and department CODES (cc:code) are the join keys to the PostgreSQL tables.

@prefix cc:    <https://kg.cream-collar.com/campus/ontology#> .
@prefix dept:  <https://kg.cream-collar.com/campus/department/> .
@prefix subj:  <https://kg.cream-collar.com/campus/subject/> .
@prefix fac:   <https://kg.cream-collar.com/campus/faculty/> .
@prefix skill: <https://kg.cream-collar.com/campus/skill/> .
@prefix track: <https://kg.cream-collar.com/campus/track/> .
@prefix rem:   <https://kg.cream-collar.com/campus/remedial/> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

# ── Ontology ─────────────────────────────────────────────────────────────
cc:Department a owl:Class ; rdfs:label "Department" ; rdfs:comment "An academic department that admits students and offers subjects." .
cc:Subject a owl:Class ; rdfs:label "Subject" ; rdfs:comment "A course in the curriculum, identified by its subject code." .
cc:Faculty a owl:Class ; rdfs:label "Faculty" ; rdfs:comment "A member of the teaching staff." .
cc:Skill a owl:Class ; rdfs:label "Skill" ; rdfs:comment "A competency that one or more subjects develop." .
cc:CareerTrack a owl:Class ; rdfs:label "CareerTrack" ; rdfs:comment "A job role described by the skills it requires." .
cc:RemedialCourse a owl:Class ; rdfs:label "RemedialCourse" ; rdfs:comment "A short bridge course offered to students who need academic attention." .

cc:code a owl:DatatypeProperty ; rdfs:label "code" ; rdfs:range xsd:string ; rdfs:comment "Short code. For a Subject or Department this equals the code used in the PostgreSQL tables." .
cc:offeredBy a owl:ObjectProperty ; rdfs:label "offeredBy" ; rdfs:domain cc:Subject ; rdfs:range cc:Department ; rdfs:comment "The department that runs the subject." .
cc:semester a owl:DatatypeProperty ; rdfs:label "semester" ; rdfs:domain cc:Subject ; rdfs:range xsd:integer ; rdfs:comment "Semester in which the subject is taught." .
cc:credits a owl:DatatypeProperty ; rdfs:label "credits" ; rdfs:domain cc:Subject ; rdfs:range xsd:integer ; rdfs:comment "Credit value of the subject." .
cc:subjectType a owl:DatatypeProperty ; rdfs:label "subjectType" ; rdfs:domain cc:Subject ; rdfs:range xsd:string ; rdfs:comment "Either Theory or Lab." .
cc:hasPrerequisite a owl:ObjectProperty ; rdfs:label "hasPrerequisite" ; rdfs:domain cc:Subject ; rdfs:range cc:Subject ; rdfs:comment "DIRECT prerequisite. Follow it transitively (hasPrerequisite+) for the full chain." .
cc:taughtBy a owl:ObjectProperty ; rdfs:label "taughtBy" ; rdfs:domain cc:Subject ; rdfs:range cc:Faculty ; rdfs:comment "The faculty member teaching the subject." .
cc:develops a owl:ObjectProperty ; rdfs:label "develops" ; rdfs:domain cc:Subject ; rdfs:range cc:Skill ; rdfs:comment "A skill the subject builds." .
cc:memberOf a owl:ObjectProperty ; rdfs:label "memberOf" ; rdfs:domain cc:Faculty ; rdfs:range cc:Department ; rdfs:comment "The department a faculty member belongs to." .
cc:headedBy a owl:ObjectProperty ; rdfs:label "headedBy" ; rdfs:domain cc:Department ; rdfs:range cc:Faculty ; rdfs:comment "The Head of Department." .
cc:designation a owl:DatatypeProperty ; rdfs:label "designation" ; rdfs:domain cc:Faculty ; rdfs:range xsd:string ; rdfs:comment "Academic rank." .
cc:email a owl:DatatypeProperty ; rdfs:label "email" ; rdfs:domain cc:Faculty ; rdfs:range xsd:string ; rdfs:comment "Contact address." .
cc:establishedYear a owl:DatatypeProperty ; rdfs:label "establishedYear" ; rdfs:domain cc:Department ; rdfs:range xsd:integer ; rdfs:comment "Year the department was founded." .
cc:requiresSkill a owl:ObjectProperty ; rdfs:label "requiresSkill" ; rdfs:domain cc:CareerTrack ; rdfs:range cc:Skill ; rdfs:comment "A skill the career track needs." .
cc:supports a owl:ObjectProperty ; rdfs:label "supports" ; rdfs:domain cc:RemedialCourse ; rdfs:range cc:Subject ; rdfs:comment "A subject the remedial course helps with." .
cc:coordinatedBy a owl:ObjectProperty ; rdfs:label "coordinatedBy" ; rdfs:domain cc:RemedialCourse ; rdfs:range cc:Faculty ; rdfs:comment "Who runs the remedial course." .
cc:durationWeeks a owl:DatatypeProperty ; rdfs:label "durationWeeks" ; rdfs:domain cc:RemedialCourse ; rdfs:range xsd:integer ; rdfs:comment "Length in weeks." .
cc:mode a owl:DatatypeProperty ; rdfs:label "mode" ; rdfs:domain cc:RemedialCourse ; rdfs:range xsd:string ; rdfs:comment "Weekend or Evening." .
cc:seatLimit a owl:DatatypeProperty ; rdfs:label "seatLimit" ; rdfs:domain cc:RemedialCourse ; rdfs:range xsd:integer ; rdfs:comment "Maximum enrolment." .


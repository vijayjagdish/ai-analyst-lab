      "reference_sql": "SELECT COUNT(*) FROM (SELECT sp.student_id FROM student_performance sp JOIN subject_details sd ON sd.subject = sp.subject WHERE sp.semester = 3 AND ((sp.marks IS NULL OR sp.marks * 100.0 / sp.total_marks < CASE WHEN sd.subject_type = 'Lab' THEN 50 ELSE 40 END) OR sp.attendance < 75) GROUP BY sp.student_id HAVING COUNT(*) >= 2) AS flagged"

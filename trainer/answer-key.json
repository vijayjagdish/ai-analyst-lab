          "Esha Varghese",
          "CS24048"
        ]
      ],
      "reference_sql": "SELECT sp.student_id, sp.student_name, ROUND(SUM(COALESCE(sp.marks, 0)) * 100.0 / SUM(sp.total_marks), 2) AS aggregate FROM student_performance sp JOIN subject_details sd ON sd.subject = sp.subject WHERE sp.semester = 4 GROUP BY sp.student_id, sp.student_name HAVING SUM(COALESCE(sp.marks, 0)) * 100.0 / SUM(sp.total_marks) >= 80 AND BOOL_AND(NOT (sp.marks IS NULL OR sp.marks * 100.0 / sp.total_marks < CASE WHEN sd.subject_type = 'Lab' THEN 50 ELSE 40 END)) AND BOOL_AND(sp.attendance IS NULL OR sp.attendance >= 85) ORDER BY aggregate DESC, sp.student_id"
    },

  "public": [
    {
      "id": "P1",
      "category": "sql",
      "question": "Which department has the highest average percentage of marks, and what is that average?",
      "requires": [
        "sql"
      ],
      "answer_includes": [
        [
          "CSE",
          "Computer Science and Engineering"
        ]
      ],
      "answer_numbers": [
        {
          "value": 68.47,
          "tolerance": 0.05,
          "what": "average percentage of CSE"
        }
      ],
      "evidence_numbers": [
        {
          "value": 68.47,
          "tolerance": 0.01,
          "what": "the same figure in a SQL result"
        }
      ],
      "reference_sql": "SELECT department, ROUND(AVG(marks * 100.0 / total_marks), 2) AS average_percentage FROM student_performance GROUP BY department ORDER BY average_percentage DESC",
      "notes": "AVG ignores NULL marks, which is what AR-3/AR-4 require. Averaging raw marks instead of percentages gives a different (wrong) figure because labs are out of 50."
    },
    {
      "id": "P2",
      "category": "policy+sql",
      "question": "What is the pass percentage of each department, and which department has the lowest?",
      "requires": [
        "policy",
        "sql"
      ],
      "rules": [
        [
          "AR-2"
        ]
      ],
      "answer_includes": [
        [
          "ME",
          "Mechanical Engineering"
        ]
      ],
      "answer_numbers": [
        {
          "value": 90.63,
          "tolerance": 0.05,
          "what": "pass percentage of ME"
        }
      ],
      "evidence_numbers": [
        {
          "value": 90.63,
          "tolerance": 0.01,
          "what": "pass percentage of ME"
        },
        {
          "value": 93.13,
          "tolerance": 0.01,
          "what": "pass percentage of CE"
        },
        {
          "value": 96.04,
          "tolerance": 0.01,
          "what": "pass percentage of CSE"
        },
        {
          "value": 96.04,
          "tolerance": 0.01,
          "what": "pass percentage of ECE"
        },
        {
          "value": 98.96,
          "tolerance": 0.01,
          "what": "pass percentage of IT"
        }
      ],
      "reference_sql": "SELECT sp.department, ROUND(100.0 * COUNT(*) FILTER (WHERE NOT (sp.marks IS NULL OR sp.marks * 100.0 / sp.total_marks < CASE WHEN sd.subject_type = 'Lab' THEN 50 ELSE 40 END)) / COUNT(*), 2) AS pass_percentage FROM student_performance sp JOIN subject_details sd ON sd.subject = sp.subject GROUP BY sp.department ORDER BY pass_percentage",
      "notes": "The trap: laboratory papers pass at 50 %, not 40 % (AR-2). An agent that assumes 40 % for everything reports higher pass percentages. Absent records stay in the denominator (AR-5)."
    },
    {
      "id": "P3",
      "category": "policy+sql",
      "question": "How many students need academic attention in at least one subject of semester 4?",
      "requires": [
        "policy",
        "sql"
      ],
      "rules": [
        [
          "SS-1"
        ]
      ],
      "answer_numbers": [
        {
          "value": 99,
          "tolerance": 0.001,
          "what": "students flagged in semester 4"
        }
      ],
      "reference_sql": "SELECT COUNT(DISTINCT sp.student_id) FROM student_performance sp JOIN subject_details sd ON sd.subject = sp.subject WHERE sp.semester = 4 AND ((sp.marks IS NULL OR sp.marks * 100.0 / sp.total_marks < CASE WHEN sd.subject_type = 'Lab' THEN 50 ELSE 40 END) OR sp.attendance < 75)",
      "notes": "SS-1: not passed (including absent) OR recorded attendance below 75. NULL attendance is never a shortage - `attendance < 75` is NULL, hence false, for those rows."
    },
    {
      "id": "P4",
      "category": "sql",
      "question": "How many examination records have the student marked absent, and how many records have no attendance recorded?",
      "requires": [
        "sql"
      ],
      "answer_numbers": [
        {
          "value": 14,
          "tolerance": 0.001,
          "what": "absent records"
        },
        {
          "value": 18,
          "tolerance": 0.001,
          "what": "records without attendance"
        }
      ],
      "reference_sql": "SELECT COUNT(*) FILTER (WHERE marks IS NULL) AS absent, COUNT(*) FILTER (WHERE attendance IS NULL) AS attendance_not_recorded FROM student_performance",
      "notes": "Tests that the load kept NULLs as NULLs (DD-6). A loader that wrote 0 or '' makes this 0."
    },
